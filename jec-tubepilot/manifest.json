{
  "manifest_version": 3,
  "name": "JEC TubePilot — SEO YouTube par Gemini",
  "short_name": "TubePilot",
  "version": "4.1.0",
  "description": "Gemini écoute et regarde vos vidéos (même privées) : titres à forte accroche, description avec timeline, tags ≤ 500, mots-clés réels, concurrents, insertion auto dans Studio.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "JEC TubePilot",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "background/sw.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "sidePanel",
    "scripting",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://studio.youtube.com/*",
    "https://www.youtube.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://www.googleapis.com/*",
    "https://suggestqueries.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://studio.youtube.com/*"],
      "js": ["lib/format.js", "lib/policy.js", "lib/seo.js", "content/ui-kit.js", "content/studio.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["lib/format.js", "lib/policy.js", "lib/seo.js", "content/ui-kit.js", "content/youtube.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content/yt-main.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["engine/engine.html", "content/shadow.css", "icons/icon32.png"],
      "matches": ["https://studio.youtube.com/*", "https://www.youtube.com/*"]
    }
  ]
}
